# Copy this file to `.env` and edit as needed. `.env` is gitignored.
# `bash run.sh` and `docker compose` both read it automatically.

# ---------------------------------------------------------------------------
# Demo flow (the "single command" path graders use)
# ---------------------------------------------------------------------------

# Where to fetch the preprocessed FastMRI dataset. Pick one:
#
# 1. RECOMMENDED - Hugging Face Hub Datasets. Free, no quota, fast.
#    See README.md "Hosting the dataset" for the 4-command upload steps.
#    Both the /resolve/ and /blob/ URL forms work (we auto-rewrite the latter):
#
#      PROCESSED_DATA_URL=https://huggingface.co/datasets/<user>/<repo>/resolve/main/processed.tar.gz
#
# 2. GitHub Releases asset URL (also works, 2 GB per-file limit):
#
#      PROCESSED_DATA_URL=https://github.com/<user>/<repo>/releases/download/<tag>/processed.tar.gz
#
# 3. Any other public HTTPS URL pointing at a .tar.gz / .tar / .zip.
#
# 4. LEGACY FALLBACK - Google Drive *folder* URL. Slow (one HTTP request per
#    file) and rate-limit-prone, but works without re-uploading if you only
#    have the unpacked folder on Drive. Example:
#
#      PROCESSED_DATA_URL=https://drive.google.com/drive/folders/<folder-id>
#
# Note: Google Drive *file* URLs (drive.google.com/file/d/...) are NOT
# supported for the >100MB tarball - Google's virus-scan UI and per-file
# quota break scripted downloads. Use Hugging Face or GitHub Releases.
#
# If splits.json isn't included in the upload, it is regenerated
# deterministically from the .npy filenames (seed=42, 70/20/10 by volume).
PROCESSED_DATA_URL=https://huggingface.co/datasets/UMaryland/brain-mri-superresolution-group11/resolve/main/processed.tar.gz

# Optional fallback: where to fetch the bundled `checkpoints/` folder if it's
# missing locally (e.g. a fresh git clone without the binary blobs). When the
# `checkpoints/` folder ships in the zip submission you can leave this empty.
CHECKPOINTS_URL=

# ---------------------------------------------------------------------------
# Local FastMRI raw data (only needed if you re-run preprocess yourself)
# ---------------------------------------------------------------------------

# Absolute path to the directory holding raw FastMRI brain .h5 files.
# Example: /Users/you/datasets/fastmri/brain/multicoil_train
FASTMRI_DIR=/absolute/path/to/fastmri/brain/multicoil_train

# Optional: space-separated list of multiple .h5 directories. If set, takes
# precedence over FASTMRI_DIR. Useful when several test batches are untarred
# into sibling folders, e.g.:
# FASTMRI_DIRS="data/multicoil_test data/multicoil_test_2 data/multicoil_test_3"
# FASTMRI_DIRS=

# ---------------------------------------------------------------------------
# Where caches/outputs land on the host (defaults are repo-relative)
# ---------------------------------------------------------------------------

PROCESSED_DIR=./data/processed
RUNS_DIR=./runs

# Force a specific torch device. Leave blank for auto-detect (CUDA > MPS > CPU).
# Allowed values: cuda, mps, cpu
# BRAINSR_DEVICE=
