# Copy to `.env` and edit. `bash run.sh` and `docker compose` both read it.
# `.env` is gitignored.

# --- Demo flow (the "single command" path graders use) ---------------------

# Where to fetch the preprocessed FastMRI dataset. Recommended host is
# Hugging Face Hub Datasets - free, no quota, designed for ML artifacts.
# Both /resolve/ (raw bytes) and /blob/ (HTML page) URLs work; we rewrite
# the latter automatically. GitHub Releases asset URLs and any other public
# HTTPS .tar.gz / .tar / .zip also work. Drive *folder* URLs work as a slow
# fallback; Drive *file* URLs are not supported (virus-scan + quota issues
# break scripted downloads for files >100MB).
#
# If the upload doesn't include splits.json, the downloader regenerates it
# deterministically (seed=42, 70/20/10 by volume).
PROCESSED_DATA_URL=https://huggingface.co/datasets/UMaryland/brain-mri-superresolution-group11/resolve/main/processed.tar.gz

# --- Local FastMRI raw data (only for re-running preprocess) ---------------

# Absolute path to a directory of raw FastMRI brain .h5 files.
FASTMRI_DIR=/absolute/path/to/fastmri/brain/multicoil_train

# Optional: space-separated list of multiple .h5 directories. Takes
# precedence over FASTMRI_DIR when set.
# FASTMRI_DIRS="data/multicoil_test data/multicoil_test_2"

# --- Where caches/outputs land on the host (defaults are repo-relative) ----

PROCESSED_DIR=./data/processed
RUNS_DIR=./runs

# Force a torch device. Leave blank for auto-detect (CUDA > MPS > CPU).
# BRAINSR_DEVICE=cuda
