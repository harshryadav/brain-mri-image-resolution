# Copy this file to `.env` and fill in your local paths.
# `.env` is gitignored.

# Absolute path to the directory holding the FastMRI brain .h5 files.
# Example: /Users/you/datasets/fastmri/brain/multicoil_train
FASTMRI_DIR=/absolute/path/to/fastmri/brain/multicoil_train

# Optional: space-separated list of multiple .h5 directories. If set, takes
# precedence over FASTMRI_DIR. Useful when you've untarred several test
# batches into sibling folders, e.g.:
# FASTMRI_DIRS="data/multicoil_test data/multicoil_test_2 data/multicoil_test_3"
# Note the quotes if any path contains spaces.
# FASTMRI_DIRS=

# Optional: override where the processed cache and run outputs land on the host.
# Defaults map to ./data/processed and ./runs in the repo.
PROCESSED_DIR=./data/processed
RUNS_DIR=./runs
